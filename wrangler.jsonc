{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nix-cf-proof",
  "main": "src/index.ts",
  "account_id": "011a6e75d63f7a427a6bd2cb50d27081",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "ai": { "binding": "AI" },
  "vars": { "ACCOUNT_ID": "011a6e75d63f7a427a6bd2cb50d27081" },
  "containers": [
    {
      "class_name": "SandboxComputer",
      "scheduling_policy": "durable_object",
      "images": {
        "sandbox": {
          "image": "registry.cloudflare.com/011a6e75d63f7a427a6bd2cb50d27081/nix-cf-proof@sha256:4c08359f1d0fac1679236000a1b6236b07d0d69e4fecf78a32881163c12f3fb4"
        }
      }
    },
    {
      "class_name": "VirtualMachine",
      "scheduling_policy": "durable_object",
      "images": {
        "nixos": {
          "image": "registry.cloudflare.com/011a6e75d63f7a427a6bd2cb50d27081/nix-cf-proof@sha256:4c08359f1d0fac1679236000a1b6236b07d0d69e4fecf78a32881163c12f3fb4"
        },
        "ubuntu": {
          "image": "registry.cloudflare.com/011a6e75d63f7a427a6bd2cb50d27081/vm-ubuntu@sha256:f610ab94648195aa356059f5b41d6085c9d4d903c072430cdd1af7bdb646106b"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "SANDBOX", "class_name": "SandboxComputer" },
      { "name": "VM", "class_name": "VirtualMachine" }
    ]
  },
  "exports": {
    "SandboxComputer": { "type": "durable-object", "storage": "sqlite" },
    "VirtualMachine": { "type": "durable-object", "storage": "sqlite" }
  }
}
